<% layout("/layouts/boilerplate") %>

<main class="container py-4">

    <h4 class="mb-4">Campus Issues</h4>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">

        <% for (let issue of allIssues) { %>

            <div class="col">

                <div class="card">
                    <div class="card-body">

                        <h5 class="card-title">
                            <a href="/issues/<%= issue._id %>">
                                <%= issue.title %>
                            </a>
                        </h5>

                        <h6 class="card-subtitle mb-2 text-body">
                            <%= issue.category %>
                        </h6>

                        <h6 class="card-subtitle mb-2 text-body-secondary">
                            <%= issue.status %>
                        </h6>

                        <p class="card-text">
                            <%= issue.description %>
                        </p>

                        <a href="/issues/<%= issue._id %>" class="card-link">
                            Details
                        </a>

                        <a href="/issues/<%= issue._id %>/edit" class="card-link">
                            Edit
                        </a>

                    </div>
                </div>

            </div>

        <% } %>

    </div>

</main>
