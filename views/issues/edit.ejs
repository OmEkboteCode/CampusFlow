<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CampusFlow</title>
</head>
<body>
    <main class="form-container">
        <h2>Edit Issue</h2>
        <p class="issue-info"><b><%= issue.title %></b></p>
        <form method="post" action="/issues/<%= issue._id %>?_method=PUT">
            <label for="title">Title: </label>
            <br>
            <input id="title" name="issue[title]" value="<%= issue.title %>">
            <br>
            <label for="description">Description: </label>
            <br>
            <textarea id="description" name="issue[description]" cols="40" rows="5"><%= issue.description %></textarea>
            <br>
            <label for="category">Category: </label>
            <br>
            <input id="category" name="issue[category]" value="<%= issue.category %>">
            <br>
            <label for="location">Location: </label>
            <br>
            <input id="location" name="issue[location]" value="<%= issue.location %>">
            <br>
            <label for="status">Status: </label>
            <br>
            <select id="status" name="issue[status]" id="status">
                <option value="Open">Open</option>
                <option value="In Progress">In Progress</option>
                <option value="Resolved">Resolved</option>
            </select>
            <br>
            <label for="status">Image URL: </label>
            <br>
            <input name="issue[image]" id="image" value="<%= issue.image.url %>">
            <br>
            <button>Edit</button>
        </form>
    </main>

</body>
</html>