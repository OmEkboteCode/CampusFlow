<% layout("/layouts/boilerplate") %>
<main class="form-container">
  <div class="row mt-2">
    <div class="col-10 offset-1">
      <h2>Edit Issue</h2>
      <p class="issue-info"><b><%= issue.title %></b></p>
      <form method="post" action="/issues/<%= issue._id %>?_method=PUT">
        <div class="mb-3">
          <label for="title" class="form-label">Title: </label>
          <br />
          <input
            id="title"
            name="issue[title]"
            value="<%= issue.title %>"
            class="form-control"
          />
        </div>

        <!-- Description -->
        <div class="mb-3">
          <label for="description">Description: </label>
          <br />
          <textarea
            id="description"
            name="issue[description]"
            cols="40"
            rows="5"
            class="form-control"
          >
<%= issue.description %></textarea
          >
        </div>


        <!-- Category -->
        <div class="mb-3">
        <label for="category">Category: </label>
        <br />
        <input
          id="category"
          name="issue[category]"
          value="<%= issue.category %>"
          class="form-control"
        />
        </div>



        <div class="mb-3">
            <label for="location">Location: </label>
            <br />
            <input
            id="location"
            name="issue[location]"
            value="<%= issue.location %>"
            class="form-control"
            />
        </div>


        <div class="mb-3">
            <label for="status">Status: </label>
            <br />
            <select id="status" name="issue[status]" id="status" class="form-control">
            <option value="Open">Open</option>
            <option value="In Progress">In Progress</option>
            <option value="Resolved">Resolved</option>
            </select>
        </div>


        <div class="mb-3">
            <label for="image">Image URL: </label>
            <br />
            <input name="issue[image]" id="image" value="<%= issue.image.url %>" class="form-control" />
        </div>
        <button class="btn btn-primary mt-3 edit-btn">Edit</button>
      </form>
    </div>
  </div>
</main>
