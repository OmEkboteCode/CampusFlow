<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CampusFlow</title>
</head>
<body>
    <main class="show-container">
        <header>
            <h2>Issue Info</h2>
        </header>
    </main>
    <section class="issue-info">
        <ul>
            <li><%= issue.title %></li>
            <li><%= issue.description %></li>
            <li><%= issue.category %></li>
            <li><%= issue.location %></li>
            <li><%= issue.status %></li>
            <li><%= issue.createdAt %></li>
        </ul>
        <br>
        
    </section>
    <footer>
        <a href="/issues/<%= issue._id %>/edit">Edit Issue</a>
        <br><br>
        <form method="POST" action="/issues/<%= issue._id %>?_method=DELETE">
            <button class="delete">
                Delete
            </button>
        </form>
    </footer>
</body>
</html>