<%- layout("/layouts/boilerplate") %>

<div class="row mt-3">
    <div class="col-8 offset-2">

        <main class="show-container">

            <header>
                <h2>Issue Info</h2>
            </header>

            <section class="issue-info mt-4">

                <div class="card">
                    <div class="card-body">

                        <h5 class="card-title"><%= issue.title %></h5>

                        <p class="card-text">
                            <strong>Description:</strong>
                            <%= issue.description %>
                        </p>

                        <p class="card-text">
                            <strong>Category:</strong>
                            <%= issue.category %>
                        </p>

                        <p class="card-text">
                            <strong>Location:</strong>
                            <%= issue.location %>
                        </p>

                        <p class="card-text">
                            <strong>Status:</strong>
                            <%= issue.status %>
                        </p>

                        <p class="card-text">
                            <strong>Created:</strong>
                            <%= issue.createdAt %>
                        </p>

                    </div>
                </div>

            </section>

            <footer class="mt-3">
                <a href="/issues/<%= issue._id %>/edit" class="btn btn-primary">
                    Edit Issue
                </a>

                <form method="POST" action="/issues/<%= issue._id %>?_method=DELETE" class="d-inline">
                    <button class="btn btn-dark">
                        Delete
                    </button>
                </form>
            </footer>

        </main>

    </div>
</div>