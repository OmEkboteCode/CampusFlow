<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CampusFlow</title>
</head>
<body>
    <main class="show-container">
        <header>Issues</header>
    </main>
    <section class="issue-details">
        <ul>
            <li><%= issue.title %></li>
            <li><%= issue.description %></li>
            <li><%= issue.category %></li>
            <li><%= issue.location %></li>
            <li><%= issue.status %></li>
            <li><%= issue.createdAt %></li>
        </ul>
    </section>
</body>
</html>